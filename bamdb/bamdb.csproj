<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.0.0</Version>
    <Authors>Bryan Apellanes</Authors>
    <Company>Three Headz</Company>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>Core of the Bam Framework for .NET</Description>
    <PackageVersion>2.0.0</PackageVersion>
    <IntermediatePackDir Condition=" '$(OS)' == 'Windows_NT' ">$(HOMEDRIVE)$(HOMEPATH)/.bam/build/pack/$(Configuration)/$(MSBuildThisFileName)/</IntermediatePackDir>
    <IntermediatePackDir Condition=" '$(OS)' == 'UNIX' ">$(HOME)/.bam/build/pack/$(Configuration)/$(MSBuildThisFileName)/</IntermediatePackDir>
    <PublishDir>$(IntermediatePackDir)$(TargetFramework)/</PublishDir>
    <NuspecProperties>publishDir=$([MSBuild]::NormalizeDirectory($(IntermediatePackDir)))</NuspecProperties>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <NuspecFile>bamdb.nuspec</NuspecFile>
  </PropertyGroup>
  <PropertyGroup>
    <OutputPath Condition=" '$(OS)' == 'Windows_NT' ">$(HOMEDRIVE)$(HOMEPATH)\.bam\build\$(Configuration)\$(MSBuildThisFileName)\</OutputPath>
    <OutputPath Condition=" '$(OS)' == 'UNIX' ">$(HOME)\.bam\build\$(Configuration)\$(MSBuildThisFileName)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="_legacy\**" />
    <EmbeddedResource Remove="_legacy\**" />
    <None Remove="_legacy\**" />
    <None Update="DaoRepoGenerationConfig\bam.protocol.data.server.dao-repo-gen.yaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="DaoRepoGenerationConfig\bam.blobs.distributed.dao-repo-gen.yaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="DaoRepoGenerationConfig\bam.protocol.data.client.dao-repo-gen.yaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="DaoRepoGenerationConfig\bam.protocol.data.profile.dao-repo-gen.yaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="DaoRepoGenerationConfig\bam.protocol.data.private.dao-repo-gen.yaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="DaoRepoGenerationConfig\bam.protocol.data.common.dao-repo-gen.yaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(BamFrameworkRoot)bam.base\bam.base\bam.base.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.configuration\bam.configuration\bam.configuration.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.console\bam.console\bam.console.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.data.dynamic\bam.data.dynamic\bam.data.dynamic.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.data.objects\bam.data.objects\bam.data.objects.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.data.repositories\bam.data.repositories\bam.data.repositories.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.data.schema\bam.data.schema\bam.data.schema.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.data\bam.data.config\bam.data.config.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.data\bam.data.firebird\bam.data.firebird.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.data\bam.data.mssql\bam.data.mssql.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.data\bam.data.mysql\bam.data.mysql.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.data\bam.data.oracle\bam.data.oracle.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.data\bam.data.postgres\bam.data.postgres.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.data\bam.data\bam.data.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.encryption\bam.encryption\bam.encryption.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.generators\bam.generators\bam.generators.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.logging\bam.logging\bam.logging.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.presentation\bam.presentation\bam.presentation.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.protocol\bam.protocol\bam.protocol.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.server\bam.server\bam.server.csproj" />
    <ProjectReference Include="$(BamFrameworkRoot)bam.shell\bam.shell\bam.shell.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <Target Name="EnsureIntermediatePackDir" BeforeTargets="GenerateNuspec">
    <MakeDir Directories="$(PublishDir)" />
  </Target>
</Project>
